# Copier vers .env (jamais commité) et remplacer TOUTES les valeurs « changez-moi ».
# Génération d'une clé : python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Base de données (Docker Compose) ---
POSTGRES_DB=ciat
POSTGRES_USER=ciat
POSTGRES_PASSWORD=changez-moi-mot-de-passe-postgres

# --- Django ---
# Local/démonstration : config.settings.dev (HTTP, cookies non « Secure »). Production : config.settings.prod (voir docs/deploiement.md).
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=changez-moi-generer-une-cle-aleatoire-de-64-caracteres-minimum
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=gestion-admin/
ENABLE_API_DOCS=true
LOG_LEVEL=INFO
# Cookie de rafraîchissement : Strict si l'API et le frontend partagent la même origine (recommandé).
REFRESH_COOKIE_SAMESITE=Strict

# --- Authentification ---
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# --- Données de démonstration (JAMAIS en production réelle) ---
ALLOW_DEMO_SEED=false

# --- Assistant IA (facultatif : sans clé, l'assistant affiche « service non configuré ») ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=500

# --- Exports ---
EXPORT_MAX_ROWS=5000

# --- Docker ---
WEB_PORT=8080
